# GPU variant — CUDA-enabled base image + cu130 torch wheel, matching the
# fine-tuned embedding models' saved environment (torch==2.12.0+cu130).
FROM nvidia/cuda:13.0.0-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3-pip \
    libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libgdk-pixbuf2.0-0 \
    libreoffice --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir torch==2.12.0 --index-url https://download.pytorch.org/whl/cu130 \
    && pip install --no-cache-dir -r requirements.txt

COPY . .

ENV APP_HOST=0.0.0.0
ENV APP_PORT=9400
ENV EMBEDDING_DEVICE=cuda
EXPOSE 9400

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "9400"]
