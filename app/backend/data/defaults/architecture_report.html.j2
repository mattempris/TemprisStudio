{#
  The job architecture as a standalone client deliverable.

  One file, no network. The data is embedded as JSON and every chart is drawn from it by the
  script at the bottom — so this works from an email attachment, which is the only distribution
  channel that reliably exists.

  Reports the result, not the method. See services/exports/report.py.

  Sections render only when their data exists, and the nav is built from the same condition, so
  a project that skipped job evaluation has no Levelling heading rather than an empty one.
#}
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ d.meta.client }} — job architecture</title>
<style>
:root{
  --paper:oklch(98.8% 0.004 42);--paper-raised:oklch(99.6% 0.003 42);--paper-sunken:oklch(96.6% 0.006 42);
  --ink:oklch(23% 0.012 35);--ink-secondary:oklch(40% 0.014 35);--ink-muted:oklch(46% 0.012 38);--ink-faint:oklch(58% 0.012 38);
  --line:oklch(89% 0.006 42);--line-strong:oklch(82% 0.008 42);
  --oxblood:oklch(42% 0.16 27);--oxblood-hover:oklch(36% 0.15 27);--oxblood-wash:oklch(96% 0.02 30);
  --data-teal:oklch(50% 0.10 220);--data-teal-soft:oklch(72% 0.07 220);--data-grey:oklch(64% 0.01 40);
  --radius-sm:6px;--radius-md:10px;--radius-lg:14px;--radius-pill:999px;
  --shadow-resting:0 1px 2px oklch(23% 0.01 35 / 0.05);--shadow-raised:0 4px 16px oklch(23% 0.01 35 / 0.07);
  --ease-out-expo:cubic-bezier(0.23,1,0.32,1);--ease-out-quart:cubic-bezier(0.25,1,0.5,1);
  --font-sans:"Schibsted Grotesk",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  --text-display:clamp(2.25rem,1.4rem + 2.6vw,3.5rem);--text-h1:clamp(2rem,1.4rem + 2vw,3rem);
  --text-h2:clamp(1.5rem,1.2rem + 1.1vw,2.125rem);--text-h3:1.375rem;--text-lead:1.1875rem;
  --text-base:1rem;--text-sm:0.875rem;--text-eyebrow:0.8125rem;--text-eyebrow-ls:0.09em;
  --container:1120px;--section-pad:clamp(3rem,6vw,5rem);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:110px}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font-sans);font-size:var(--text-base);line-height:1.62;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
h1,h2,h3,h4{text-wrap:balance;margin:0}p{text-wrap:pretty;margin:0}
.tabular{font-variant-numeric:tabular-nums}
.container{max-width:var(--container);margin:0 auto;padding:0 24px}
:focus-visible{outline:2px solid var(--oxblood);outline-offset:2px;border-radius:2px}
a{color:inherit}

header.top{border-bottom:1px solid var(--line);padding:18px 0;background:var(--paper)}
header.top .container{display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand svg{height:38px;width:auto;display:block}
.top-tag{font-size:var(--text-sm);color:var(--ink-muted)}

nav.report-nav{position:sticky;top:0;z-index:30;background:oklch(98.8% 0.004 42 / 0.92);backdrop-filter:saturate(1.1) blur(6px);border-bottom:1px solid var(--line)}
nav.report-nav .container{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding-top:10px;padding-bottom:10px}
nav.report-nav a{font-size:var(--text-sm);font-weight:500;color:var(--ink-muted);text-decoration:none;padding:7px 14px;border-radius:var(--radius-pill);transition:color 160ms var(--ease-out-quart),background 160ms var(--ease-out-quart)}
nav.report-nav a:hover{color:var(--ink);background:var(--paper-sunken)}
nav.report-nav a.active{color:var(--oxblood);background:var(--oxblood-wash)}

.eyebrow-row{display:flex;align-items:center;gap:12px}
.eyebrow-rule{display:inline-block;width:32px;height:1px;background:var(--oxblood)}
.eyebrow{font-size:var(--text-eyebrow);letter-spacing:var(--text-eyebrow-ls);text-transform:uppercase;font-weight:500;color:var(--ink-muted)}
.section-head h2{font-size:var(--text-h2);line-height:1.16;letter-spacing:-0.01em;font-weight:600;margin-top:16px;max-width:32ch}
.section-head .lead{margin-top:16px;font-size:var(--text-lead);line-height:1.55;color:var(--ink-secondary);max-width:66ch}
section.block{padding:var(--section-pad) 0;border-bottom:1px solid var(--line);scroll-margin-top:80px}

.hero h1{font-size:var(--text-display);line-height:1.06;letter-spacing:-0.02em;font-weight:600;margin-top:20px;max-width:22ch}
.hero h1 .ox{color:var(--oxblood)}
.hero .lead{margin-top:22px;font-size:var(--text-lead);line-height:1.55;color:var(--ink-secondary);max-width:64ch}
.hero .meta{margin-top:28px;font-size:var(--text-sm);color:var(--ink-muted);display:flex;gap:28px;flex-wrap:wrap}
.hero .meta b{color:var(--ink-secondary);font-weight:500}
.kpis{margin-top:40px;display:flex;gap:48px;flex-wrap:wrap}
.stat{display:flex;flex-direction:column;gap:4px}
.stat-value{font-size:var(--text-h1);line-height:1.02;font-weight:600;color:var(--oxblood);letter-spacing:-0.01em}
.stat-label{font-size:var(--text-sm);color:var(--ink-muted);max-width:20ch}

.controls{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:22px 0 18px}
.seg{display:inline-flex;background:var(--paper-sunken);border:1px solid var(--line);border-radius:var(--radius-pill);padding:3px}
.seg button{font:inherit;font-size:var(--text-sm);font-weight:500;border:none;background:transparent;color:var(--ink-muted);padding:7px 16px;border-radius:var(--radius-pill);cursor:pointer;transition:color 160ms,background 160ms}
.seg button.active{background:var(--paper-raised);color:var(--oxblood);box-shadow:var(--shadow-resting)}
.hint{font-size:var(--text-sm);color:var(--ink-faint)}

#treemap{width:100%;height:520px;display:block}
#treemap rect.cell{cursor:default;transition:stroke 140ms var(--ease-out-quart)}
#treemap rect.cell:hover{stroke:var(--oxblood);stroke-width:1.5px}
#treemap text{pointer-events:none}
.tm-label{font-weight:600;fill:var(--ink)}
.tm-sub{fill:var(--ink-secondary)}

.tooltip{position:fixed;background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius-md);padding:14px 16px;box-shadow:var(--shadow-raised);width:310px;z-index:1000;font-size:var(--text-sm);color:var(--ink);pointer-events:none;opacity:0;transition:opacity 120ms}
.tooltip h4{font-size:var(--text-base);font-weight:600;margin:0 0 6px}
.tooltip .tt-meta{color:var(--ink-muted);margin-bottom:8px}
.tooltip .tt-list{color:var(--ink-secondary);margin:0;padding-left:18px}

.bars{display:flex;flex-direction:column;gap:2px}
.bar-row{display:grid;gap:5px;padding:11px 12px;border-radius:var(--radius-sm);border:1px solid transparent}
.bar-row:hover{background:var(--paper-sunken)}
.bar-row .br-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.bar-row .br-name{font-weight:500;font-size:var(--text-base)}
.bar-row .br-n{font-size:var(--text-sm);color:var(--ink-muted);white-space:nowrap}
.bar-row .br-track{height:8px;border-radius:999px;background:var(--paper-sunken);overflow:hidden}
.bar-row .br-fill{height:100%;border-radius:999px;background:var(--oxblood);transition:width 480ms var(--ease-out-expo)}
.bar-row .br-fill.teal{background:var(--data-teal)}
.bar-row .br-sub{font-size:var(--text-sm);color:var(--ink-faint)}
.axis-note{display:flex;justify-content:space-between;font-size:var(--text-sm);color:var(--ink-faint);margin-bottom:10px;padding:0 12px}

.two-col{display:grid;grid-template-columns:1.05fr 0.95fr;gap:40px;align-items:start}
@media(max-width:900px){.two-col{grid-template-columns:1fr}}
.card{padding:22px 24px;background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-resting)}
.card .c-eyebrow{font-size:var(--text-sm);color:var(--ink-muted);text-transform:uppercase;letter-spacing:0.06em;font-weight:500}
.card .c-title{font-size:var(--text-h3);font-weight:600;margin-top:4px;line-height:1.2}
.card .c-meta{font-size:var(--text-sm);color:var(--ink-secondary);margin-top:8px}
.sticky{position:sticky;top:120px}

table.data{width:100%;border-collapse:collapse;font-size:var(--text-sm)}
table.data th{text-align:left;font-weight:500;color:var(--ink-muted);border-bottom:1px solid var(--line-strong);padding:8px 10px;white-space:nowrap}
table.data td{border-bottom:1px solid var(--line);padding:8px 10px;vertical-align:top}
table.data td.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
table.data tbody tr:hover{background:var(--paper-sunken)}
.scroll-x{overflow-x:auto}

.tree{border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-raised);overflow:hidden}
.tree-row{display:flex;align-items:baseline;gap:10px;padding:10px 16px;border-bottom:1px solid var(--line);cursor:pointer;background:none;border-left:none;border-right:none;border-top:none;width:100%;text-align:left;font:inherit;color:inherit}
.tree-row:last-child{border-bottom:none}
.tree-row:hover{background:var(--paper-sunken)}
.tree-row .tw{margin-left:auto;font-size:var(--text-sm);color:var(--ink-muted);font-variant-numeric:tabular-nums;white-space:nowrap}
.tree-row.fam{font-weight:600}
.tree-row.cat{padding-left:38px;font-size:var(--text-sm)}
.tree-row.role{padding-left:60px;font-size:var(--text-sm);color:var(--ink-secondary)}
.tree-row .chev{color:var(--ink-faint);width:12px;flex-shrink:0}
.role-detail{padding:20px 24px;border-top:1px solid var(--line-strong);background:var(--paper-sunken)}
.role-detail h4{font-size:var(--text-h3);font-weight:600}
.role-detail .rd-meta{font-size:var(--text-sm);color:var(--ink-muted);margin-top:4px}
.rd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px;margin-top:18px}
.rd-grid h5{font-size:var(--text-eyebrow);letter-spacing:var(--text-eyebrow-ls);text-transform:uppercase;font-weight:500;color:var(--ink-muted);margin:0 0 8px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{font-size:var(--text-sm);padding:3px 10px;border-radius:var(--radius-pill);background:var(--paper-raised);border:1px solid var(--line)}
.rd-list{margin:0;padding-left:18px;font-size:var(--text-sm);color:var(--ink-secondary)}
.pill{display:inline-block;font-size:var(--text-sm);padding:2px 10px;border-radius:var(--radius-pill);background:var(--oxblood-wash);color:var(--oxblood);font-weight:500}

footer.foot{padding:40px 0 64px;font-size:var(--text-sm);color:var(--ink-faint)}
footer.foot p{max-width:80ch}
@media print{
  nav.report-nav{display:none}
  section.block{page-break-inside:avoid;border-bottom:none}
  .sticky{position:static}
}
</style>
</head>
<body>

<header class="top">
  <div class="container">
    <span class="brand">{% include "tempris_mark.svg.j2" %}</span>
    <span class="top-tag">Job architecture · {{ d.meta.generated }}</span>
  </div>
</header>

{% set has_lvl = d.levelling is not none %}
{% set has_skills = d.skills is not none %}
{% set has_work = d.work is not none %}
<nav class="report-nav">
  <div class="container">
    <a href="#overview">Overview</a>
    <a href="#structure">Structure</a>
    {% if has_lvl %}<a href="#levelling">Levelling</a>{% endif %}
    {% if has_skills %}<a href="#capability">Capability</a>{% endif %}
    {% if has_work %}<a href="#work">Work</a>{% endif %}
    <a href="#explore">Explore</a>
  </div>
</nav>

{% set t = d.architecture.totals %}
{% set hc = d.architecture.has_headcount %}
<section class="block hero" id="overview">
  <div class="container">
    <div class="eyebrow-row"><span class="eyebrow-rule"></span><span class="eyebrow">Tempris job architecture</span></div>
    <h1>A single structure for <span class="ox">{{ d.meta.client }}</span>.</h1>
    <p class="lead">
      Every role in the estate resolved into a coherent hierarchy of job families, categories and
      anchor roles — built from the work itself rather than from the org chart. This is a guided
      read of that structure{% if has_lvl %}, how it levels{% endif %}{% if has_skills %}, the
      capability it rests on{% endif %}{% if has_work %} and where the workforce's time actually
      goes{% endif %}.
    </p>
    <div class="meta">
      <span>Prepared for <b>{{ d.meta.client }}</b></span>
      <span>Date <b>{{ d.meta.generated }}</b></span>
    </div>
    <div class="kpis">
      <div class="stat"><span class="stat-value tabular">{{ t.families }}</span><span class="stat-label">job families</span></div>
      <div class="stat"><span class="stat-value tabular">{{ t.categories }}</span><span class="stat-label">job categories</span></div>
      <div class="stat"><span class="stat-value tabular">{{ t.profile_count }}</span><span class="stat-label">anchor roles</span></div>
      {% if hc and t.headcount %}
      <div class="stat"><span class="stat-value tabular">{{ "{:,}".format(t.headcount) }}</span><span class="stat-label">people</span></div>
      {% endif %}
      <div class="stat"><span class="stat-value tabular">{{ "{:,}".format(t.source_job_count) }}</span><span class="stat-label">source job records</span></div>
    </div>
  </div>
</section>

<section class="block" id="structure">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow-row"><span class="eyebrow-rule"></span><span class="eyebrow">The structure</span></div>
      <h2>{% if hc %}Your workforce, sized by job family.{% else %}The architecture, sized by role count.{% endif %}</h2>
      <p class="lead">
        Each block is a job {% if hc %}family, sized by the number of people it holds{% else %}family,
        sized by the number of anchor roles it holds{% endif %}. Switch to categories to see how each
        one breaks down. Hover any block for what sits inside it.
      </p>
    </div>
    <div class="controls">
      <div class="seg" id="tm-seg">
        <button data-level="family" class="active">Job families</button>
        <button data-level="category">Job categories</button>
      </div>
      <span class="hint">{% if hc %}Area is headcount{% else %}Area is the number of anchor roles — this project carried no headcount column{% endif %}</span>
    </div>
    <svg id="treemap" role="img" aria-label="Job architecture sized by {% if hc %}headcount{% else %}role count{% endif %}"></svg>
  </div>
</section>

{% if has_lvl %}
{% set L = d.levelling %}
<section class="block" id="levelling">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow-row"><span class="eyebrow-rule"></span><span class="eyebrow">Levelling</span></div>
      <h2>How the roles grade out.</h2>
      <p class="lead">
        Every anchor role scored against your job evaluation framework and mapped to a band. Each
        bar is one band; the number beside it is how many roles{% if hc %} and how many people{% endif %}
        landed there. An empty band is a real finding — it says the structure has no roles at that level.
      </p>
    </div>
    <div class="two-col">
      <div>
        <div class="axis-note"><span>Entry</span><span>Executive</span></div>
        <div class="bars">
          {% set maxband = L.bands | map(attribute='roles') | max %}
          {% for b in L.bands %}
          <div class="bar-row">
            <div class="br-top">
              <span class="br-name">{{ b.name }}</span>
              <span class="br-n tabular">
                {% if b.roles %}{{ b.roles }} role{{ "" if b.roles == 1 else "s" }}{% if b.headcount %} · {{ "{:,}".format(b.headcount) }} people{% endif %}{% else %}none{% endif %}
              </span>
            </div>
            <div class="br-track"><div class="br-fill" style="width:{{ (100 * b.roles / maxband) if maxband else 0 }}%"></div></div>
            <div class="br-sub tabular">score {{ b.min_score | round(0) | int }}–{{ b.max_score | round(0) | int }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
      <div class="sticky">
        <div class="card">
          <div class="c-eyebrow">Evaluation</div>
          <div class="c-title">{{ L.evaluated }} of {{ L.of }} roles scored</div>
          <p class="c-meta">
            Scores run {{ L.min_score }} to {{ L.max_score }} on a 0–100 scale, mean {{ L.mean_score }}.
            {% if L.mean_spread %}
            The panel's optimistic and conservative readings differ by {{ L.mean_spread }} points on
            average — the band within which a role's grade is genuinely arguable.
            {% endif %}
          </p>
          {% if L.domains %}
          <div style="margin-top:18px">
            <h5 style="font-size:var(--text-eyebrow);letter-spacing:var(--text-eyebrow-ls);text-transform:uppercase;font-weight:500;color:var(--ink-muted);margin:0 0 8px">Weighted on</h5>
            <div class="chips">
              {% for dom in L.domains %}<span class="chip">{{ dom.name }} · {{ dom.weight | round(0) | int }}%</span>{% endfor %}
            </div>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if has_skills %}
<section class="block" id="capability">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow-row"><span class="eyebrow-rule"></span><span class="eyebrow">Capability</span></div>
      <h2>What the organisation runs on.</h2>
      <p class="lead">
        {{ "{:,}".format(d.skills.n_skills) }} attributes read out of the role documents and resolved
        into a skill taxonomy.
        {% if d.skills.role_mapped %}
        The bar is how many anchor roles draw on each family — a wide family is something the whole
        organisation depends on, a narrow one is specialist.
        {% else %}
        The bar is how many distinct skill clusters each family holds. Roles have not been mapped
        onto the taxonomy for this architecture, so this describes the shape of the capability
        model rather than how widely each part of it is needed.
        {% endif %}
      </p>
    </div>
    <div class="two-col">
      <div>
        <div class="bars">
          {% set measure = 'roles' if d.skills.role_mapped else 'clusters' %}
          {% set maxv = (d.skills.families | map(attribute=measure) | max) or 1 %}
          {% for f in d.skills.families %}
          {% set v = f.roles if d.skills.role_mapped else f.clusters %}
          <div class="bar-row">
            <div class="br-top">
              <span class="br-name">{{ f.name }}</span>
              <span class="br-n tabular">
                {%- if d.skills.role_mapped -%}
                  {{ f.roles }} role{{ "" if f.roles == 1 else "s" }}
                {%- else -%}
                  {{ f.clusters }} cluster{{ "" if f.clusters == 1 else "s" }}
                {%- endif -%}
              </span>
            </div>
            <div class="br-track"><div class="br-fill teal" style="width:{{ 100 * v / maxv }}%"></div></div>
            <div class="br-sub tabular">
              {%- if d.skills.role_mapped -%}
                {{ f.clusters }} skill cluster{{ "" if f.clusters == 1 else "s" }} in
              {%- else -%}
                across
              {%- endif %} {{ f.categories | length }} categor{{ "y" if f.categories | length == 1 else "ies" }}
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      <div class="sticky">
        <div class="card">
          <div class="c-eyebrow">Taxonomy</div>
          <div class="c-title">{{ d.skills.families | length }} families</div>
          <p class="c-meta">
            {{ d.skills.n_clusters }} distinct skill clusters, grouped into
            {{ d.skills.n_categories }} categories.
            The taxonomy is derived from what the roles actually require, so a family exists because
            roles need it rather than because a framework listed it.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if has_work %}
{% set W = d.work %}
<section class="block" id="work">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow-row"><span class="eyebrow-rule"></span><span class="eyebrow">Work</span></div>
      <h2>Where the week actually goes.</h2>
      <p class="lead">
        {{ "{:,}".format(W.n_tasks) }} tasks read out of the role documents and grouped into
        {{ W.n_clusters }} task clusters, then rolled up to domain.
        {% if W.unit == 'FTE' %}Weighted by headcount, so a cluster taking most of two people's week
        does not outrank one taking a slice of four hundred.{% else %}Weighted one per role, since
        this project carried no headcount column.{% endif %}
      </p>
    </div>
    <div class="two-col">
      <div>
        <div class="bars">
          {% set maxdom = (W.domains | map(attribute='share_pct') | max) or 1 %}
          {% for dom in W.domains %}
          <div class="bar-row">
            <div class="br-top">
              <span class="br-name">{{ dom.name }}</span>
              <span class="br-n tabular">{{ dom.share_pct }}%</span>
            </div>
            <div class="br-track"><div class="br-fill" style="width:{{ 100 * dom.share_pct / maxdom }}%"></div></div>
          </div>
          {% endfor %}
        </div>
      </div>
      <div class="sticky">
        <div class="card">
          <div class="c-eyebrow">Largest task clusters</div>
          <div class="c-title">Where time concentrates</div>
          <div class="scroll-x" style="margin-top:14px">
            <table class="data">
              <thead><tr><th>Task cluster</th><th>Domain</th><th class="num">Share</th></tr></thead>
              <tbody>
                {% for c in W.clusters[:12] %}
                <tr><td>{{ c.name }}</td><td style="color:var(--ink-muted)">{{ c.domain }}</td><td class="num">{{ c.share_pct }}%</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

<section class="block" id="explore">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow-row"><span class="eyebrow-rule"></span><span class="eyebrow">Explore</span></div>
      <h2>Walk the architecture.</h2>
      <p class="lead">
        Open a job family to see its categories, then a category to see its anchor roles. Select a
        role for its detail: the source titles behind it{% if has_lvl %}, its evaluated level{% endif %}{% if has_skills %}, the skills it requires{% endif %}{% if has_work %} and how its week divides{% endif %}.
      </p>
    </div>
    <div class="tree" id="tree"></div>
    <div id="role-detail"></div>
  </div>
</section>

<footer class="foot">
  <div class="container">
    <p>
      Job architecture derived by Tempris from {{ d.meta.client }} role data.
      {% if hc %}Sizes reflect headcount in the supplied estate.{% else %}Sizes reflect the number of
      anchor roles; no headcount column was supplied.{% endif %}
      {% if d.declined %}
      Not carried out for this architecture: {{ d.declined | join(", ") }}.
      {% endif %}
      Prepared {{ d.meta.generated }}.
    </p>
  </div>
</footer>

<div class="tooltip" id="tt" role="tooltip"></div>

<script>
const D = {{ data_json | safe }};
const HC = D.architecture.has_headcount;
const fmt = n => (n == null ? "—" : n.toLocaleString());
const esc = s => String(s == null ? "" : s).replace(/[&<>"']/g, c =>
  ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

/* Size by headcount where it exists, else by the number of anchor roles. Never a synthesised
   headcount — the caption says which is in force, and mixing the two would make the areas
   incomparable. */
const sizeOf = n => (HC && n.headcount ? n.headcount : n.profile_count);

/* ---- treemap: squarified (Bruls, Huizing, van Wijk) ---------------------------------- */
function squarify(items, x, y, w, h, out) {
  if (!items.length) return out;
  const total = items.reduce((s, i) => s + i.v, 0);
  if (total <= 0 || w <= 0 || h <= 0) return out;
  if (items.length === 1) { out.push({ ...items[0], x, y, w, h }); return out; }
  // Split so the two halves' areas match their value shares, then recurse into the shorter
  // axis of each. That is what keeps cells near-square instead of slivers.
  let acc = 0, split = 0;
  for (let i = 0; i < items.length; i++) {
    acc += items[i].v;
    if (acc >= total / 2) { split = i + 1; break; }
  }
  split = Math.min(Math.max(split, 1), items.length - 1);
  const head = items.slice(0, split), tail = items.slice(split);
  const frac = head.reduce((s, i) => s + i.v, 0) / total;
  if (w >= h) {
    const wl = w * frac;
    squarify(head, x, y, wl, h, out);
    squarify(tail, x + wl, y, w - wl, h, out);
  } else {
    const ht = h * frac;
    squarify(head, x, y, w, ht, out);
    squarify(tail, x, y + ht, w, h - ht, out);
  }
  return out;
}

/* One hue per family, so a category keeps its family's colour when the view switches — that
   continuity is what makes the toggle readable rather than a redraw. */
const HUES = D.architecture.families.map((f, i) => [f.name, 12 + (i * 360 / Math.max(1, D.architecture.families.length))]);
const hueOf = name => (HUES.find(h => h[0] === name) || ["", 20])[1];

const tt = document.getElementById("tt");
function showTip(html, ev) {
  tt.innerHTML = html;
  tt.style.opacity = "1";
  const r = tt.getBoundingClientRect();
  let left = ev.clientX + 16, top = ev.clientY + 16;
  if (left + r.width > innerWidth - 12) left = ev.clientX - r.width - 16;
  if (top + r.height > innerHeight - 12) top = Math.max(12, ev.clientY - r.height - 16);
  tt.style.left = left + "px"; tt.style.top = top + "px";
}
const hideTip = () => { tt.style.opacity = "0"; };

let tmLevel = "family";
function drawTreemap() {
  const svg = document.getElementById("treemap");
  const W = svg.clientWidth || 1000, H = svg.clientHeight || 520;
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
  const nodes = [];
  if (tmLevel === "family") {
    for (const f of D.architecture.families) {
      nodes.push({ v: sizeOf(f), name: f.name, family: f.name, node: f, kind: "family" });
    }
  } else {
    for (const f of D.architecture.families) {
      for (const c of f.categories) {
        nodes.push({ v: sizeOf(c), name: c.name, family: f.name, node: c, kind: "category" });
      }
    }
  }
  const live = nodes.filter(n => n.v > 0).sort((a, b) => b.v - a.v);
  const cells = squarify(live, 0, 0, W, H, []);

  const unit = HC ? "people" : "roles";
  svg.innerHTML = cells.map(c => {
    const hue = hueOf(c.family);
    const light = 88 - Math.min(34, 34 * (c.v / (cells[0] ? cells[0].v : 1)));
    const fill = `oklch(${light}% 0.055 ${hue})`;
    const showLabel = c.w >= 92 && c.h >= 34;
    const showSub = c.w >= 62 && c.h >= 50;
    return `<g>
      <rect class="cell" x="${c.x}" y="${c.y}" width="${Math.max(0, c.w - 1)}" height="${Math.max(0, c.h - 1)}"
        fill="${fill}" stroke="var(--paper)" stroke-width="1" data-i="${cells.indexOf(c)}"></rect>
      ${showLabel ? `<text class="tm-label" x="${c.x + 10}" y="${c.y + 22}" font-size="13">${esc(clip(c.name, c.w))}</text>` : ""}
      ${showSub ? `<text class="tm-sub" x="${c.x + 10}" y="${c.y + 40}" font-size="12">${fmt(c.v)} ${unit}</text>` : ""}
    </g>`;
  }).join("");

  svg.querySelectorAll("rect.cell").forEach(r => {
    const c = cells[+r.dataset.i];
    r.addEventListener("mousemove", ev => {
      const n = c.node;
      const kids = c.kind === "family"
        ? n.categories.map(x => `${esc(x.name)} — ${fmt(sizeOf(x))} ${unit}`)
        : n.profiles.slice(0, 8).map(p => `${esc(p.title)}${p.headcount ? ` — ${fmt(p.headcount)}` : ""}`);
      const more = c.kind === "category" && n.profiles.length > 8 ? n.profiles.length - 8 : 0;
      showTip(
        `<h4>${esc(n.name)}</h4>
         <div class="tt-meta">${fmt(sizeOf(c.node))} ${unit} · ${n.profile_count} anchor role${n.profile_count === 1 ? "" : "s"}${c.kind === "category" ? "" : ` · ${n.categories.length} categories`}${n.mean_je_score ? ` · mean score ${n.mean_je_score}` : ""}</div>
         <ul class="tt-list">${kids.map(k => `<li>${k}</li>`).join("")}${more ? `<li>and ${more} more</li>` : ""}</ul>`,
        ev);
    });
    r.addEventListener("mouseleave", hideTip);
  });
}
/* Rough character budget for the cell width — a label that overflows its rect reads as a bug,
   and SVG has no overflow:hidden to fall back on. */
function clip(s, w) { const max = Math.floor((w - 18) / 6.6); return s.length > max ? s.slice(0, Math.max(1, max - 1)) + "…" : s; }

document.getElementById("tm-seg").addEventListener("click", ev => {
  const b = ev.target.closest("button"); if (!b) return;
  tmLevel = b.dataset.level;
  document.querySelectorAll("#tm-seg button").forEach(x => x.classList.toggle("active", x === b));
  drawTreemap();
});

/* ---- explore tree -------------------------------------------------------------------- */
const open = { fam: null, cat: null, role: null };
/* One noun, not two. Without a headcount column `sizeOf` *is* the role count and the unit is
   "roles", so printing both said "47 roles · 47 roles". */
function weight(n) {
  const roles = plural(n.profile_count, "role");
  return HC && n.headcount ? `${roles} · ${fmt(n.headcount)} people` : roles;
}
const plural = (n, noun) => `${fmt(n)} ${noun}${n === 1 ? "" : "s"}`;

function drawTree() {
  const rows = [];
  for (const f of D.architecture.families) {
    const fo = open.fam === f.id;
    rows.push(`<button class="tree-row fam" data-fam="${f.id}">
      <span class="chev">${fo ? "▾" : "▸"}</span><span>${esc(f.name)}</span>
      <span class="tw">${weight(f)}</span></button>`);
    if (!fo) continue;
    for (const c of f.categories) {
      const co = open.cat === c.id;
      rows.push(`<button class="tree-row cat" data-fam="${f.id}" data-cat="${c.id}">
        <span class="chev">${co ? "▾" : "▸"}</span><span>${esc(c.name)}</span>
        <span class="tw">${weight(c)}</span></button>`);
      if (!co) continue;
      for (const p of c.profiles) {
        rows.push(`<button class="tree-row role" data-role="${esc(p.profile_key)}">
          <span class="chev"></span><span>${esc(p.title)}</span>
          <span class="tw">${p.headcount ? fmt(p.headcount) + " people" : plural(p.source_job_count, "source title")}${p.evaluation ? " · " + esc(p.evaluation.level_name) : ""}</span></button>`);
      }
    }
  }
  document.getElementById("tree").innerHTML = rows.join("");
  document.getElementById("role-detail").innerHTML = open.role ? roleDetail(open.role) : "";
}

function findRole(key) {
  for (const f of D.architecture.families)
    for (const c of f.categories)
      for (const p of c.profiles)
        if (p.profile_key === key) return { p, c, f };
  return null;
}

function roleDetail(key) {
  const hit = findRole(key); if (!hit) return "";
  const { p, c, f } = hit;
  const tasks = (p.tasks || []).slice(0, 10);
  return `<div class="role-detail">
    <h4>${esc(p.title)}</h4>
    <div class="rd-meta">${esc(f.name)} › ${esc(c.name)}${p.headcount ? ` · ${fmt(p.headcount)} ${HC ? "people" : "roles"}` : ""}${p.evaluation ? ` · <span class="pill">${esc(p.evaluation.level_name)} · ${p.evaluation.aggregate_score}</span>` : ""}</div>
    <div class="rd-grid">
      <div>
        <h5>Source titles (${p.source_job_count})</h5>
        <div class="chips">${p.source_titles.slice(0, 14).map(s => `<span class="chip">${esc(s)}</span>`).join("")}
        ${p.source_titles.length > 14 ? `<span class="chip">+${p.source_titles.length - 14} more</span>` : ""}</div>
      </div>
      ${p.skills && p.skills.length ? `<div>
        <h5>Skills required (${p.skill_count})</h5>
        <div class="chips">${p.skills.slice(0, 16).map(s => `<span class="chip">${esc(s.cluster_name)}${s.assigned_level ? ` · ${esc(s.assigned_level)}` : ""}</span>`).join("")}</div>
      </div>` : ""}
      ${tasks.length ? `<div>
        <h5>Where the week goes</h5>
        <ul class="rd-list">${tasks.map(t2 => `<li>${esc(t2.name)} — ${t2.proportion}%</li>`).join("")}
        ${p.task_count > tasks.length ? `<li>and ${p.task_count - tasks.length} more</li>` : ""}</ul>
      </div>` : ""}
      ${p.taxonomy_match ? `<div>
        <h5>Market taxonomy</h5>
        <div class="chips"><span class="chip">${esc(p.taxonomy_match.spec_title)}</span>
        <span class="chip">${esc(p.taxonomy_match.family_title)}</span>
        ${p.taxonomy_match.level_title ? `<span class="chip">${esc(p.taxonomy_match.level_title)}</span>` : ""}</div>
      </div>` : ""}
    </div>
  </div>`;
}

document.getElementById("tree").addEventListener("click", ev => {
  const b = ev.target.closest(".tree-row"); if (!b) return;
  if (b.dataset.role) { open.role = open.role === b.dataset.role ? null : b.dataset.role; }
  else if (b.dataset.cat) {
    const id = +b.dataset.cat;
    open.cat = open.cat === id ? null : id; open.role = null;
  } else {
    const id = +b.dataset.fam;
    open.fam = open.fam === id ? null : id; open.cat = null; open.role = null;
  }
  drawTree();
});

/* ---- nav highlight ------------------------------------------------------------------- */
const links = [...document.querySelectorAll("nav.report-nav a")];
const io = new IntersectionObserver(es => {
  for (const e of es) {
    if (!e.isIntersecting) continue;
    links.forEach(a => a.classList.toggle("active", a.getAttribute("href") === "#" + e.target.id));
  }
}, { rootMargin: "-45% 0px -50% 0px" });
document.querySelectorAll("section.block").forEach(s => io.observe(s));

drawTreemap();
drawTree();
addEventListener("resize", drawTreemap);
</script>
</body>
</html>
